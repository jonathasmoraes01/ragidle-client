{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"buildCommand": "",
	"installCommand": "",
	"outputDirectory": ".",
	"routes": [
		{
			"src": "^/$",
			"has": [
				{
					"type": "host",
					"value": "play.roclassicidle.com.br"
				}
			],
			"dest": "/api.html"
		},
		{
			"src": "^/(Online|ThreadEventHandler|PathFindingWorker|api)\\.js$",
			"headers": {
				"Cache-Control": "public, max-age=0, must-revalidate"
			},
			"continue": true
		},
		{
			"src": "^/(index\\.html|api\\.html|Config\\.js|Config\\.local\\.js)$",
			"headers": {
				"Cache-Control": "no-cache"
			},
			"continue": true
		},
		{
			"src": "^/assets/(.*)$",
			"headers": {
				"Cache-Control": "public, max-age=3600"
			},
			"continue": true
		},
		{
			"src": "^/css/(.*)$",
			"headers": {
				"Cache-Control": "public, max-age=0, must-revalidate"
			},
			"continue": true
		},
		{
			"src": "^/js/(.*)$",
			"headers": {
				"Cache-Control": "public, max-age=0, must-revalidate"
			},
			"continue": true
		},
		{
			"handle": "filesystem"
		}
	]
}
